generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core exercise library ────────────────────────────────────────────────────

model TrainingItem {
  id             String   @id @default(uuid())
  sourceId       String?  @map("source_id")
  fen            String
  sideToMove     String   @map("side_to_move")       // "w" | "b"
  solutionMoves  String[] @map("solution_moves")      // UCI array
  solutionSan    String?  @map("solution_san")
  sourceName     String   @map("source_name")
  sourceAuthor   String   @map("source_author")
  sourceYear     Int      @map("source_year")
  chapter        String?
  exerciseNumber Int?     @map("exercise_number")
  difficulty     String?                              // "easy" | "intermediate" | "advanced" | null
  theme          String?
  tags           String[]
  itemType       String   @map("item_type")           // "calculation"
  createdAt      DateTime @default(now()) @map("created_at")

  attempts        PuzzleAttempt[]
  seriesItems     TrainingSeriesItem[]
  exerciseAttempts ExerciseAttempt[]

  @@index([difficulty])
  @@index([chapter])
  @@index([sideToMove])
  @@index([sourceName])
  @@index([chapter, difficulty])
  @@map("training_items")
}

// ── Legacy attempt log (standalone puzzles) ──────────────────────────────────

model PuzzleAttempt {
  id             String   @id @default(uuid())
  trainingItemId String   @map("training_item_id")
  isCorrect      Boolean  @map("is_correct")
  movePlayed     String   @map("move_played")
  expectedMove   String   @map("expected_move")
  timeMs         Int      @map("time_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id])

  @@index([trainingItemId])
  @@index([createdAt])
  @@map("puzzle_attempts")
}

// ── Woodpecker training series ───────────────────────────────────────────────

model TrainingSeries {
  id           String   @id @default(uuid())
  devUserId    String   @default("dev-user-001") @map("dev_user_id")
  title        String
  sourceName   String   @map("source_name")
  chapter      String?
  mode         String   @default("CHAPTER")  // CHAPTER | FULL_BOOK | FAILED_ONLY | CUSTOM
  status       String   @default("ACTIVE")   // ACTIVE | COMPLETED | ARCHIVED
  totalItems   Int      @map("total_items")
  currentIndex Int      @default(0) @map("current_index")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cycles TrainingCycle[]
  items  TrainingSeriesItem[]

  @@index([devUserId])
  @@index([status])
  @@map("training_series")
}

model TrainingSeriesItem {
  id             String   @id @default(uuid())
  seriesId       String   @map("series_id")
  trainingItemId String   @map("training_item_id")
  orderIndex     Int      @map("order_index")
  createdAt      DateTime @default(now()) @map("created_at")

  series       TrainingSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  trainingItem TrainingItem   @relation(fields: [trainingItemId], references: [id])

  @@unique([seriesId, trainingItemId])
  @@index([seriesId])
  @@index([trainingItemId])
  @@map("training_series_items")
}

model TrainingCycle {
  id             String    @id @default(uuid())
  seriesId       String    @map("series_id")
  cycleNumber    Int       @map("cycle_number")
  status         String    @default("ACTIVE")  // ACTIVE | COMPLETED
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  totalExercises Int       @map("total_exercises")
  solvedCount    Int       @default(0) @map("solved_count")
  correctCount   Int       @default(0) @map("correct_count")
  incorrectCount Int       @default(0) @map("incorrect_count")
  totalTimeMs    Int       @default(0) @map("total_time_ms")
  averageTimeMs  Int       @default(0) @map("average_time_ms")
  accuracy       Float     @default(0)
  bestStreak     Int       @default(0) @map("best_streak")
  createdAt      DateTime  @default(now()) @map("created_at")

  series   TrainingSeries    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  attempts ExerciseAttempt[]

  @@index([seriesId])
  @@index([cycleNumber])
  @@map("training_cycles")
}

// ── Per-exercise attempt with series/cycle context ───────────────────────────

model ExerciseAttempt {
  id             String   @id @default(uuid())
  trainingItemId String   @map("training_item_id")
  seriesId       String   @map("series_id")   // denormalized for fast queries
  cycleId        String   @map("cycle_id")
  movePlayed     String   @map("move_played")
  expectedMove   String   @map("expected_move")
  isCorrect      Boolean  @map("is_correct")
  timeMs         Int      @map("time_ms")
  attemptNumber  Int      @map("attempt_number")
  fen            String
  createdAt      DateTime @default(now()) @map("created_at")

  trainingItem TrainingItem  @relation(fields: [trainingItemId], references: [id])
  cycle        TrainingCycle @relation(fields: [cycleId], references: [id])

  @@index([trainingItemId])
  @@index([seriesId])
  @@index([cycleId])
  @@index([createdAt])
  @@map("exercise_attempts")
}

// ── Opening Repertoire ───────────────────────────────────────────────────────

model OpeningRepertoire {
  id          String   @id @default(uuid())
  devUserId   String   @default("dev-user-001") @map("dev_user_id")
  name        String
  color       String   // "WHITE" | "BLACK"
  sourceType  String   @map("source_type")   // "PGN" | "CHESSBASE_EXPORT" | "MANUAL"
  sourceName  String   @map("source_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lines    OpeningLine[]
  nodes    OpeningMoveNode[]
  attempts OpeningAttempt[]

  @@index([devUserId])
  @@map("opening_repertoires")
}

model OpeningLine {
  id            String   @id @default(uuid())
  repertoireId  String   @map("repertoire_id")
  name          String
  eco           String?
  side          String   // "white" | "black"
  pgn           String
  startFen      String   @map("start_fen")
  finalFen      String   @map("final_fen")
  moveCount     Int      @map("move_count")
  isMainLine    Boolean  @default(true) @map("is_main_line")
  orderIndex    Int      @default(0) @map("order_index")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  repertoire OpeningRepertoire  @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  lineNodes  OpeningLineNode[]
  attempts   OpeningAttempt[]

  @@index([repertoireId])
  @@index([eco])
  @@map("opening_lines")
}

model OpeningMoveNode {
  id           String   @id @default(uuid())
  repertoireId String   @map("repertoire_id")
  parentId     String?  @map("parent_id")
  moveNumber   Int      @map("move_number")
  san          String
  uci          String
  fenBefore    String   @map("fen_before")
  fenAfter     String   @map("fen_after")
  ply          Int
  eco          String?
  lineName     String?  @map("line_name")
  path         String   // e2e4.e7e5.g1f3 — unique per repertoire
  depth        Int
  orderIndex   Int      @default(0) @map("order_index")
  isMainLine   Boolean  @default(false) @map("is_main_line")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repertoire OpeningRepertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  parent     OpeningMoveNode?  @relation("NodeChildren", fields: [parentId], references: [id])
  children   OpeningMoveNode[] @relation("NodeChildren")
  lineNodes  OpeningLineNode[]
  attempts   OpeningAttempt[]

  @@unique([repertoireId, path])
  @@index([repertoireId])
  @@index([parentId])
  @@index([fenAfter])
  @@index([eco])
  @@map("opening_move_nodes")
}

model OpeningLineNode {
  id         String @id @default(uuid())
  lineId     String @map("line_id")
  nodeId     String @map("node_id")
  orderIndex Int    @map("order_index")

  line OpeningLine     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  node OpeningMoveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([lineId, nodeId])
  @@index([lineId])
  @@index([nodeId])
  @@map("opening_line_nodes")
}

model OpeningAttempt {
  id           String   @id @default(uuid())
  repertoireId String   @map("repertoire_id")
  lineId       String?  @map("line_id")
  nodeId       String   @map("node_id")
  movePlayed   String   @map("move_played")
  expectedMove String   @map("expected_move")
  isCorrect    Boolean  @map("is_correct")
  timeMs       Int      @map("time_ms")
  attemptType  String   @default("PRACTICE") @map("attempt_type") // "PRACTICE" | "QUIZ" | "REVIEW"
  createdAt    DateTime @default(now()) @map("created_at")

  repertoire OpeningRepertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  line       OpeningLine?      @relation(fields: [lineId], references: [id])
  node       OpeningMoveNode   @relation(fields: [nodeId], references: [id])

  @@index([repertoireId])
  @@index([lineId])
  @@index([nodeId])
  @@index([createdAt])
  @@map("opening_attempts")
}
